define
# Billing uses the same person/tenant model as IAM. Provider state is private:
# frontend queries cannot manufacture payments or saved-method attestations.
# Buyer consent is a schema-validated immutable grant, never an application flag.
attribute bill_key, value string;
attribute bill_customer_claim, value string;
attribute bill_email, value string;
attribute bill_policy, value string @values("customer", "manual", "automatic");
attribute bill_choice, value string @values("manual", "automatic");
attribute bill_provider, value string;
attribute bill_bindings, value string;
attribute bill_method_plugin, value string;
attribute bill_status, value string;
attribute bill_amount, value integer @range(50..99999999);
attribute bill_due_days, value integer @range(0..90);
attribute bill_anchor, value integer;
attribute bill_next, value integer;
attribute bill_sequence, value integer @range(0..);
attribute bill_interval, value string @values("once", "week", "month", "year");
attribute bill_stripe_id @meta("dog.security.hidden", "true"), value string;
attribute bill_mercury_id @meta("dog.security.hidden", "true"), value string;
attribute bill_payment_method, value string;
attribute bill_consent, value string;
attribute bill_external_id @meta("dog.security.hidden", "true"), value string;
attribute bill_removed_method @meta("dog.security.hidden", "true"), value string;
attribute bill_url, value string;
attribute bill_updated, value integer;
attribute bill_revision, value string;
attribute bill_history @meta("dog.security.hidden", "true"), value string;
entity bill_customer,
  owns bill_key @key, owns bill_customer_claim @card(0..1) @unique, owns name @card(1), owns bill_email @card(1),
  owns bill_policy @card(1), owns bill_choice @card(1), owns bill_provider @card(1),
  owns bill_stripe_id @card(0..1), owns bill_mercury_id @card(0..1),
  owns bill_bindings @card(1), owns bill_method_plugin @card(1),
  owns bill_payment_method @card(1), owns bill_consent @card(1), owns bill_revision @card(1),
  owns bill_removed_method @card(0..);
relation bill_account, relates merchant @card(1), relates buyer @card(1), relates customer @card(1);
tenant plays bill_account:merchant, plays bill_account:buyer;
bill_customer plays bill_account:customer @card(1);
entity bill_plan,
  owns bill_key @key, owns name @card(1), owns bill_amount @card(1), owns bill_due_days @card(1),
  owns bill_anchor @card(1), owns bill_next @card(1), owns bill_sequence @card(1),
  owns bill_interval @card(1), owns bill_status @card(1);
relation bill_plan_owner, relates customer @card(1), relates plan @card(1);
bill_customer plays bill_plan_owner:customer;
bill_plan plays bill_plan_owner:plan @card(1);
entity bill_invoice,
  owns bill_key @key, owns name @card(1), owns bill_amount @card(1), owns bill_anchor @card(1),
  owns bill_next @card(1), owns bill_sequence @card(1), owns bill_choice @card(1),
  owns bill_provider @card(1), owns bill_status @card(1), owns bill_external_id @card(1),
  owns bill_url @card(1), owns bill_updated @card(1), owns bill_revision @card(1),
  owns bill_history @card(0..1);
relation bill_invoice_owner, relates plan @card(1), relates invoice @card(1);
bill_plan plays bill_invoice_owner:plan;
bill_invoice plays bill_invoice_owner:invoice @card(1);
entity bill_notice, owns bill_key @key, owns bill_status @card(1), owns bill_updated @card(1);
relation bill_notice_owner, relates invoice @card(1), relates notice @card(1);
bill_invoice plays bill_notice_owner:invoice;
bill_notice plays bill_notice_owner:notice @card(1);
entity bill_consent_evidence, owns bill_key @key, owns bill_revision @card(1), owns bill_updated @card(0..1);
relation bill_consent_owner, relates customer @card(1), relates actor @card(1), relates evidence @card(1);
bill_customer plays bill_consent_owner:customer;
identity plays bill_consent_owner:actor;
bill_consent_evidence plays bill_consent_owner:evidence @card(1);

fun bill_seller($i: identity, $t: tenant, $c: bill_customer, $now: datetime) -> boolean:
  match (merchant:$t,customer:$c) isa bill_account;
    let $ok=role_at_least($i,$t,"owner",$now); $ok==true;
  return check;
fun bill_buyer($i: identity, $t: tenant, $c: bill_customer, $now: datetime) -> boolean:
  match (buyer:$t,customer:$c) isa bill_account;
    let $ok=role_at_least($i,$t,"owner",$now); $ok==true;
  return check;
fun bill_reader($i: identity, $t: tenant, $c: bill_customer, $now: datetime) -> boolean:
  match { let $seller=bill_seller($i,$t,$c,$now); $seller==true; }
    or { let $buyer=bill_buyer($i,$t,$c,$now); $buyer==true; };
  return check;
fun scope_bill_customer($tenant: string, $actor: string, $now: datetime, $c: bill_customer) -> boolean:
  match $t isa tenant, has tenant_id == $tenant;
    $i isa person, has identity_id == $actor;
    let $ok=bill_reader($i,$t,$c,$now); $ok==true;
  return check;
fun scope_bill_plan($tenant: string, $actor: string, $now: datetime, $p: bill_plan) -> boolean:
  match (customer:$c,plan:$p) isa bill_plan_owner; $c isa bill_customer;
    let $ok=scope_bill_customer($tenant,$actor,$now,$c); $ok==true;
  return check;
fun scope_bill_invoice($tenant: string, $actor: string, $now: datetime, $i: bill_invoice) -> boolean:
  match (plan:$p,invoice:$i) isa bill_invoice_owner; $p isa bill_plan;
    let $ok=scope_bill_plan($tenant,$actor,$now,$p); $ok==true;
  return check;
fun scope_bill_plan_owner($tenant: string, $actor: string, $now: datetime, $o: bill_plan_owner) -> boolean:
  match $o links(customer:$c,plan:$p); $c isa bill_customer; $p isa bill_plan;
    let $ok=scope_bill_customer($tenant,$actor,$now,$c); $ok==true;
  return check;
fun scope_bill_invoice_owner($tenant: string, $actor: string, $now: datetime, $o: bill_invoice_owner) -> boolean:
  match $o links(plan:$p,invoice:$i); $p isa bill_plan; $i isa bill_invoice;
    let $ok=scope_bill_plan($tenant,$actor,$now,$p); $ok==true;
  return check;
# An immutable buyer grant is the sole authority for automatic collection.
# Legacy customer choice/consent fields remain read-only historical data.
attribute consent_claim, value string;
attribute consent_plan_count,value integer @range(1..60);
entity bill_consent_evidence, owns consent_plan_count @card(0..1), owns consent_claim @card(0..1) @unique,
  owns method_ref @card(0..1), owns method_plugin @card(0..1);
fun bill_has_consent($c: bill_customer) -> boolean:
  match $c has bill_revision $rev,
      has bill_method_plugin $plugin,has bill_payment_method $method,has bill_policy $policy;
    $policy!="manual";
    (customer:$c,method:$saved) isa bill_method_owner;
    $saved has method_ref == $method,has method_plugin == $plugin,has method_active true,has method_pending false,has method_automatic true;
    (customer:$c,evidence:$e) isa bill_consent_owner;
    $e has consent_claim $claim,has bill_revision == $rev,
      has method_plugin == $plugin,has method_ref == $method,has consent_at $at;
  return check;
relation bill_consent_plan, relates evidence @card(1),relates plan @card(1);
bill_consent_evidence plays bill_consent_plan:evidence;
bill_plan plays bill_consent_plan:plan;
fun bill_plan_has_consent($c: bill_customer,$p: bill_plan) -> boolean:
  match let $compatible=cx_plugin_consent($c,$p);$compatible==true; let $valid=bill_has_consent($c); $valid==true;
    $c has bill_revision $rev,has bill_method_plugin $plugin,has bill_payment_method $method;
    (customer:$c,evidence:$e) isa bill_consent_owner;
    $e has consent_claim $claim,has bill_revision == $rev,has method_plugin == $plugin,has method_ref == $method;
    (evidence:$e,plan:$p) isa bill_consent_plan;
    (customer:$c,plan:$p) isa bill_plan_owner;
  return check;
fun bill_plan_payment_choice($c: bill_customer,$p: bill_plan) -> string:
  match let $ok=bill_plan_has_consent($c,$p); {
    $ok==true; let $value="automatic";
  } or {$ok==false;let $value="manual";};
  return first $value;
fun bill_approved_revision($c: bill_customer) -> string:
  match let $ok=bill_has_consent($c); {
    $ok==true; $c has bill_revision $revision; let $value=$revision;
  } or {
    $ok==false; let $value="";
  };
  return first $value;
fun bill_payment_choice($c: bill_customer) -> string:
  match let $ok=bill_has_consent($c); {
    $ok==true; let $value="automatic";
  } or {
    $ok==false; let $value="manual";
  };
  return first $value;
fun bill_unconsented($c: bill_customer) -> boolean:
  match let $ok=bill_has_consent($c); $ok==false;
  return check;
fun update_bill_revision($tenant: string, $actor: string, $now: datetime, $c: bill_customer, $next: string) -> boolean:
  match let $ok=scope_bill_customer($tenant,$actor,$now,$c); $ok==true;
    $c has bill_revision $old; $next!=$old; $next!="";
    # A revoked billing revision can never be restored to replay old consent.
    not {(customer:$c,evidence:$old_grant) isa bill_consent_owner;
      $old_grant has bill_revision == $next;};
  return check;
fun update_bill_policy($tenant: string, $actor: string, $now: datetime, $c: bill_customer, $policy: string) -> boolean:
  match $t isa tenant, has tenant_id == $tenant; $i isa person, has identity_id == $actor;
    let $ok=bill_seller($i,$t,$c,$now); $ok==true;
    let $safe=bill_unconsented($c); $safe==true;
    { $policy=="customer"; } or { $policy=="manual"; } or { $policy=="automatic"; };
  return check;
fun create_bill_plan($tenant: string, $actor: string, $now: datetime, $p: bill_plan) -> boolean:
  match (customer:$c,plan:$p) isa bill_plan_owner; $c isa bill_customer;
    $t isa tenant, has tenant_id == $tenant; $i isa person, has identity_id == $actor;
    let $owner=bill_seller($i,$t,$c,$now); $owner==true;
    let $safe=bill_unconsented($c); $safe==true;
    $p has bill_status "active", has bill_sequence 0, has bill_anchor $anchor, has bill_next == $anchor;
  return check;
fun create_bill_plan_owner($tenant: string, $actor: string, $now: datetime, $o: bill_plan_owner) -> boolean:
  match $o links(plan:$p); $p isa bill_plan;
    let $ok=create_bill_plan($tenant,$actor,$now,$p); $ok==true;
  return check;
fun update_bill_plan_status($tenant: string, $actor: string, $now: datetime, $p: bill_plan, $next: string) -> boolean:
  match (customer:$c,plan:$p) isa bill_plan_owner; $c isa bill_customer;
    $t isa tenant, has tenant_id == $tenant; $i isa person, has identity_id == $actor;
    let $owner=bill_seller($i,$t,$c,$now); $owner==true;
    let $safe=bill_unconsented($c); $safe==true;
    $p has bill_status $old; $old!="finished";
    { $next=="active"; } or { $next=="paused"; };
  return check;

entity bill_customer @meta("dog.security.scope", "scope_bill_customer") @meta("dog.security.read", "scope_bill_customer"),
  owns bill_revision @meta("dog.security.update", "update_bill_revision"),
  owns bill_policy @meta("dog.security.update", "update_bill_policy");
entity bill_plan @meta("dog.security.scope", "scope_bill_plan") @meta("dog.security.read", "scope_bill_plan") @meta("dog.security.create", "create_bill_plan"),
  owns bill_status @meta("dog.security.update", "update_bill_plan_status");
entity bill_invoice @meta("dog.security.scope", "scope_bill_invoice") @meta("dog.security.read", "scope_bill_invoice");
relation bill_plan_owner @meta("dog.security.scope", "scope_bill_plan_owner") @meta("dog.security.read", "scope_bill_plan_owner") @meta("dog.security.create", "create_bill_plan_owner");
relation bill_invoice_owner @meta("dog.security.scope", "scope_bill_invoice_owner") @meta("dog.security.read", "scope_bill_invoice_owner");

# Provider attestations are facts, not frontend assertions. No public create or
# delete policy exists for these records or their ownership relation.
attribute method_ref, value string;
attribute method_plugin, value string;
attribute method_automatic, value boolean;
attribute method_pending, value boolean;
attribute method_active, value boolean;
attribute method_verified_at, value datetime;
attribute consent_at, value datetime;
entity bill_saved_method, owns bill_key @key, owns method_ref @card(1),
  owns method_plugin @card(1), owns method_automatic @card(1),
  owns method_pending @card(1), owns method_active @card(1), owns method_verified_at @card(1);
relation bill_method_owner, relates customer @card(1), relates method @card(1);
bill_customer plays bill_method_owner:customer;
bill_saved_method plays bill_method_owner:method @card(1);
bill_consent_evidence owns consent_at @card(0..1);
fun scope_bill_method($tenant: string,$actor: string,$now: datetime,$m: bill_saved_method) -> boolean:
  match (customer:$c,method:$m) isa bill_method_owner; $c isa bill_customer;
    $t isa tenant,has tenant_id == $tenant; $i isa identity,has identity_id == $actor;
    let $ok=bill_buyer($i,$t,$c,$now); $ok==true;
  return check;
fun usable_bill_method($c: bill_customer,$now: datetime) -> boolean:
  match $c has bill_payment_method $ref,has bill_method_plugin $plugin;
    (customer:$c,method:$m) isa bill_method_owner;
    $m has method_ref == $ref,has method_plugin == $plugin,
      has method_automatic true,has method_pending false,has method_active true,has method_verified_at $verified;
    let $fresh=$now - PT10M; $verified>=$fresh; $verified<=$now;
  return check;
fun bill_preference_editor($tenant: string,$actor: string,$now: datetime,$c: bill_customer) -> boolean:
  match $t isa tenant,has tenant_id == $tenant; $i isa identity,has identity_id == $actor;
    let $buyer=bill_buyer($i,$t,$c,$now); $buyer==true;
    let $safe=bill_unconsented($c); $safe==true;
  return check;
fun update_bill_method_plugin($tenant: string,$actor: string,$now: datetime,$c: bill_customer,$plugin: string) -> boolean:
  match let $ok=bill_preference_editor($tenant,$actor,$now,$c); $ok==true;
    (customer:$c,method:$m) isa bill_method_owner;
    $m has method_plugin == $plugin,has method_pending false,has method_active true;
  return check;
fun update_bill_method($tenant: string,$actor: string,$now: datetime,$c: bill_customer,$ref: string) -> boolean:
  match let $ok=bill_preference_editor($tenant,$actor,$now,$c); $ok==true;
    {$ref=="";} or {
      $c has bill_method_plugin $plugin;
      (customer:$c,method:$m) isa bill_method_owner;
      $m has method_ref == $ref,has method_plugin == $plugin,has method_pending false,has method_active true;
    };
  return check;
fun scope_bill_consent($tenant: string,$actor: string,$now: datetime,$e: bill_consent_evidence) -> boolean:
  match (customer:$c,evidence:$e) isa bill_consent_owner; $c isa bill_customer;
    let $ok=scope_bill_customer($tenant,$actor,$now,$c); $ok==true;
  return check;
fun create_bill_consent($tenant: string,$actor: string,$now: datetime,$e: bill_consent_evidence) -> boolean:
  match (customer:$c,actor:$by,evidence:$e) isa bill_consent_owner;
    $by isa person,has identity_id == $actor;
    $t isa tenant,has tenant_id == $tenant;
    let $buyer=bill_buyer($by,$t,$c,$now); $buyer==true;
    $c has bill_key $key,has bill_revision $rev,has bill_policy $policy,
      has bill_method_plugin $plugin,has bill_payment_method $method;
    $policy!="manual"; $rev!=""; $plugin!=""; $method!="";
    $e has bill_key $request,has consent_plan_count $expected;let $actual=bill_consent_scope_count($e);$actual==$expected;
    let $claim=$key+":"+$rev+":"+$request;
    $e has consent_claim == $claim,has bill_revision == $rev,has consent_at == $now,
      has method_plugin == $plugin,has method_ref == $method;
    not {$other isa bill_consent_evidence,has consent_claim == $claim;not {$other is $e;};};
    let $verified=usable_bill_method($c,$now); $verified==true;
    (evidence:$e,plan:$plan) isa bill_consent_plan;
    (customer:$c,plan:$plan) isa bill_plan_owner; $plan has bill_status "active";
    not {(evidence:$e,plan:$foreign) isa bill_consent_plan;
      not {(customer:$c,plan:$foreign) isa bill_plan_owner;};};
  return check;
fun scope_bill_consent_owner($tenant: string,$actor: string,$now: datetime,$o: bill_consent_owner) -> boolean:
  match $o links(evidence:$e); $e isa bill_consent_evidence;
    let $ok=scope_bill_consent($tenant,$actor,$now,$e); $ok==true;
  return check;
fun create_bill_consent_owner($tenant: string,$actor: string,$now: datetime,$o: bill_consent_owner) -> boolean:
  match $o links(evidence:$e); $e isa bill_consent_evidence;
    let $ok=create_bill_consent($tenant,$actor,$now,$e); $ok==true;
  return check;
fun update_method_pending($tenant: string,$actor: string,$now: datetime,$m: bill_saved_method,$pending: boolean) -> boolean:
  match let $ok=scope_bill_method($tenant,$actor,$now,$m); $ok==true; $pending==true;
    (customer:$c,method:$m) isa bill_method_owner;
    $m has method_ref $ref,has method_plugin $plugin;
    not {$c has bill_payment_method == $ref,has bill_method_plugin == $plugin;};
  return check;
entity bill_saved_method @meta("dog.security.scope","scope_bill_method") @meta("dog.security.read","scope_bill_method"),
  owns method_pending @meta("dog.security.update","update_method_pending");
entity bill_customer,
  owns bill_method_plugin @meta("dog.security.update","update_bill_method_plugin"),
  owns bill_payment_method @meta("dog.security.update","update_bill_method");
entity bill_consent_evidence @meta("dog.security.scope","scope_bill_consent") @meta("dog.security.read","scope_bill_consent") @meta("dog.security.create","create_bill_consent");
relation bill_consent_owner @meta("dog.security.scope","scope_bill_consent_owner") @meta("dog.security.read","scope_bill_consent_owner") @meta("dog.security.create","create_bill_consent_owner");

# Counterparty visibility is deliberately separate from scope_tenant. It exposes
# a billing buyer's tenant record, never its resources, memberships or IAM graph.
fun pending_bill_buyer($tenant: string,$actor: string,$now: datetime,$b: tenant) -> boolean:
  match $t isa tenant,has tenant_id == $tenant; $i isa identity,has identity_id == $actor;
    let $owner=role_at_least($i,$t,"owner",$now); $owner==true;
    (merchant:$t,buyer:$b) isa bill_account;
    not {(tenant:$b) isa membership;};
  return check;
fun scope_visible_tenant($tenant: string,$actor: string,$now: datetime,$b: tenant) -> boolean:
  match {let $own=tenant_member_scope($tenant,$actor,$now,$b); $own==true;} or {
    $t isa tenant,has tenant_id == $tenant; $i isa identity,has identity_id == $actor;
    let $owner=role_at_least($i,$t,"owner",$now); $owner==true;
    (merchant:$t,buyer:$b) isa bill_account;
  };
  return check;
fun create_bill_customer($tenant: string,$actor: string,$now: datetime,$c: bill_customer) -> boolean:
  match $t isa tenant,has tenant_id == $tenant; $i isa identity,has identity_id == $actor;
    let $owner=role_at_least($i,$t,"owner",$now); $owner==true;
    (merchant:$t,buyer:$b,customer:$c) isa bill_account;
    $b has status "active"; not {(tenant:$b) isa membership;};
    $c has bill_policy "customer",has bill_choice "manual",has bill_bindings "{}",
      has bill_method_plugin "",has bill_payment_method "",has bill_consent "",has bill_revision $rev;
    $rev!=""; not {(customer:$c) isa bill_plan_owner;};
    $c has bill_email $email;
    let $claim=$tenant+":"+$email; $c has bill_customer_claim == $claim;
    not {(merchant:$t,customer:$other) isa bill_account; $other has bill_email == $email; not {$other is $c;};};
  return check;
fun create_bill_buyer($tenant: string,$actor: string,$now: datetime,$b: tenant) -> boolean:
  match let $ok=pending_bill_buyer($tenant,$actor,$now,$b); $ok==true;
    $b has tenant_id $id,has status "active",has revision $revision; $id!=$tenant; $revision!="";
    (buyer:$b,customer:$c) isa bill_account; $c isa bill_customer;
    let $safe=create_bill_customer($tenant,$actor,$now,$c); $safe==true;
    not {(merchant:$b) isa bill_account;};
    not {(merchant:$other,buyer:$b) isa bill_account; $other has tenant_id $other_id; $other_id!=$tenant;};
  return check;
fun scope_bill_account($tenant: string,$actor: string,$now: datetime,$a: bill_account) -> boolean:
  match $a links(customer:$c); $c isa bill_customer;
    let $ok=scope_bill_customer($tenant,$actor,$now,$c); $ok==true;
  return check;
fun create_bill_account($tenant: string,$actor: string,$now: datetime,$a: bill_account) -> boolean:
  match $a links(customer:$c,buyer:$b); $c isa bill_customer; $b isa tenant;
    let $ok=create_bill_customer($tenant,$actor,$now,$c); $ok==true;
    let $safe=create_bill_buyer($tenant,$actor,$now,$b); $safe==true;
  return check;
entity bill_customer @meta("dog.security.create","create_bill_customer");
relation bill_account @meta("dog.security.scope","scope_bill_account") @meta("dog.security.read","scope_bill_account") @meta("dog.security.create","create_bill_account");

fun scope_bill_method_owner($tenant: string,$actor: string,$now: datetime,$o: bill_method_owner) -> boolean:
  match $o links(method:$m); $m isa bill_saved_method;
    let $ok=scope_bill_method($tenant,$actor,$now,$m); $ok==true;
  return check;
relation bill_method_owner @meta("dog.security.scope","scope_bill_method_owner") @meta("dog.security.read","scope_bill_method_owner");

# Publish only scoped consent status, without exposing private method facts.
fun request_bill_payment_choice($tenant: string,$actor: string,$now: datetime,$c: bill_customer) -> string @meta("dog.security.context","true"):
  match let $allowed=scope_bill_customer($tenant,$actor,$now,$c);$allowed==true;
    let $choice=bill_payment_choice($c);
  return first $choice;

fun request_bill_buyer($tenant: string,$actor: string,$now: datetime,$c: bill_customer) -> boolean @meta("dog.security.context","true"):
  match $t isa tenant,has tenant_id == $tenant; $i isa identity,has identity_id == $actor;
    let $allowed=bill_buyer($i,$t,$c,$now);
  return first $allowed;
fun request_bill_seller($tenant: string,$actor: string,$now: datetime,$c: bill_customer) -> boolean @meta("dog.security.context","true"):
  match $t isa tenant,has tenant_id == $tenant; $i isa identity,has identity_id == $actor;
    let $allowed=bill_seller($i,$t,$c,$now);
  return first $allowed;

# Scope links are created atomically with the grant. Exact request time prevents
# adding another plan to a previously committed consent record.
fun scope_bill_consent_plan($tenant: string,$actor: string,$now: datetime,$link: bill_consent_plan) -> boolean:
  match $link links(evidence:$e,plan:$p);$e isa bill_consent_evidence;$p isa bill_plan;
    let $proof=scope_bill_consent($tenant,$actor,$now,$e);$proof==true;
    let $plan=scope_bill_plan($tenant,$actor,$now,$p);$plan==true;
  return check;
fun create_bill_consent_plan($tenant: string,$actor: string,$now: datetime,$link: bill_consent_plan) -> boolean:
  match $link links(evidence:$e,plan:$p);$e isa bill_consent_evidence;$p isa bill_plan;
    (customer:$c,evidence:$e) isa bill_consent_owner;
    (customer:$c,plan:$p) isa bill_plan_owner;$p has bill_status "active";
    let $ok=create_bill_consent($tenant,$actor,$now,$e);$ok==true;
  return check;
relation bill_consent_plan @meta("dog.security.scope","scope_bill_consent_plan") @meta("dog.security.read","scope_bill_consent_plan") @meta("dog.security.create","create_bill_consent_plan");

# Scope cardinality seals each grant, including against later same-clock link insertion.
fun bill_consent_scope_count($e:bill_consent_evidence)->integer:
  match (evidence:$e,plan:$p) isa bill_consent_plan;
  select $p;distinct;
  return count;
fun request_bill_plan_choice($tenant:string,$actor:string,$now:datetime,$p:bill_plan)->string @meta("dog.security.context","true"):
  match let $allowed=scope_bill_plan($tenant,$actor,$now,$p);$allowed==true;
    (customer:$c,plan:$p) isa bill_plan_owner;let $choice=bill_plan_payment_choice($c,$p);
  return first $choice;
