# Generated field definitions. Run deploy/checkout/generate_schema.py --check in CI.
attribute cfg_brand, value string @regex("^[^\r\n]{0,120}$");
attribute cfg_tagline, value string @regex("^[^\r\n]{0,200}$");
attribute cfg_heading, value string @regex("^[^\r\n]{0,200}$");
attribute cfg_description, value string @regex("^[\s\S]{0,2000}$");
attribute cfg_review_label, value string @regex("^[^\r\n]{0,100}$");
attribute cfg_confirm_label, value string @regex("^[^\r\n]{0,100}$");
attribute cfg_pay_label, value string @regex("^[^\r\n]{0,100}$");
attribute cfg_footer, value string @regex("^[\s\S]{0,500}$");
attribute cfg_logo, value string @regex("^(|https://[^\s@]{1,1992})$");
attribute cfg_home, value string @regex("^(|https://[^\s@]{1,1992})$");
attribute cfg_support, value string @regex("^(|https://[^\s@]{1,1992})$");
attribute cfg_terms, value string @regex("^(|https://[^\s@]{1,1992})$");
attribute cfg_accent, value string @regex("^#[A-Fa-f0-9]{6}$");
attribute cfg_background, value string @regex("^#[A-Fa-f0-9]{6}$");
attribute cfg_foreground, value string @regex("^#[A-Fa-f0-9]{6}$");
attribute cfg_font, value string @values("system","serif","mono");
attribute cfg_layout, value string @values("cards","list","compact");
attribute cfg_locale, value string @regex("^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8}){0,4}$");
attribute cfg_timezone, value string @regex("^[A-Za-z0-9_+/-]{1,64}$");
attribute cfg_max_lines, value integer @range(1..60);
attribute cfg_max_groups, value integer @range(1..4);
attribute cfg_max_quantity, value integer @range(1..1000);
attribute cfg_default_count, value integer @range(2..360);
attribute cfg_quote_window, value string @values("5m","15m","1h","1d");
attribute cfg_refunds, value boolean;
attribute cfg_refund_window, value string @values("unlimited","day","week","month","year");
attribute cfg_reminder_days, value integer @range(1..30);
attribute cfg_default_currency, value string @values("USD","EUR","GBP","CAD","AUD","JPY");
attribute cfg_default_mode, value string @values("once","recurring","instalments");
attribute cfg_invoice_name, value string @regex("^[^\r\n]{0,120}$");
attribute cfg_help, value string @regex("^[\s\S]{0,2000}$");
attribute cfg_radius, value string @values("square","soft","round");
attribute cfg_widget_mode, value string @values("button","cart","donation","plan");
attribute cfg_widget_inline, value boolean;
attribute cfg_reminder_count, value integer @range(0..365);
attribute cfg_due_days, value integer @range(0..90);
attribute cfg_payment_theme, value string @values("stripe","night","flat");
attribute cfg_payment_layout, value string @values("tabs","accordion");
attribute cfg_widget_title, value string @regex("^[^\r\n]{0,200}$");
attribute cfg_widget_label, value string @regex("^[^\r\n]{0,100}$");
attribute cfg_hash,value string @regex("^[a-f0-9]{64}$");
attribute cfg_active,value string;
entity commerce_configuration,owns cx_id @key,owns cx_created @card(1),owns cfg_hash @card(1),owns cx_currency @card(1..6),owns cx_mode @card(1..3),owns cx_kind @card(1..3),owns cfg_brand @card(1),owns cfg_tagline @card(1),owns cfg_heading @card(1),owns cfg_description @card(1),owns cfg_review_label @card(1),owns cfg_confirm_label @card(1),owns cfg_pay_label @card(1),owns cfg_footer @card(1),owns cfg_logo @card(1),owns cfg_home @card(1),owns cfg_support @card(1),owns cfg_terms @card(1),owns cfg_accent @card(1),owns cfg_background @card(1),owns cfg_foreground @card(1),owns cfg_font @card(1),owns cfg_layout @card(1),owns cfg_locale @card(1),owns cfg_timezone @card(1),owns cfg_max_lines @card(1),owns cfg_max_groups @card(1),owns cfg_max_quantity @card(1),owns cfg_default_count @card(1),owns cfg_quote_window @card(1),owns cfg_refunds @card(1),owns cfg_refund_window @card(1),owns cfg_reminder_days @card(1),owns cfg_default_currency @card(1),owns cfg_default_mode @card(1),owns cfg_invoice_name @card(1),owns cfg_help @card(1),owns cfg_radius @card(1),owns cfg_widget_mode @card(1),owns cfg_widget_inline @card(1),owns cfg_reminder_count @card(1),owns cfg_due_days @card(1),owns cfg_payment_theme @card(1),owns cfg_payment_layout @card(1),owns cfg_widget_title @card(1),owns cfg_widget_label @card(1);
