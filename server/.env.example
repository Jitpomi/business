HTTP_HOST=127.0.0.1
HTTP_PORT=3030
TYPEDB_ADDR=https://your-cluster.cluster.typedb.com:80
TYPEDB_DB=business_native_dev
TYPEDB_USERNAME=business_dev_app
TYPEDB_PASSWORD=
TYPEDB_TLS=true
TYPEDB_FORCE_RECREATE=false
AUTH_JWT_SECRET=
BUSINESS_ACTIVE_REQUESTS=3
# Optional trusted gateway (>=32 bytes); API header: x-gateway-secret.
# BUSINESS_GATEWAY_SECRET=
# Standalone proxy / operator-import configuration only. Omit these variables entirely if a provider is unused.
# STRIPE_CONNECTIONS_JSON=[{"tenant_id":"...","identity_ids":["..."],"environment":"test","token":"sk_test_...","write":false}]
# MERCURY_CONNECTIONS_JSON=[{"tenant_id":"...","identity_ids":["..."],"environment":"sandbox","token":"...","write":false}]
# Operator-only bootstrap fields; never pass these to the deployed server.
# BUSINESS_OWNER_EMAIL=
# BUSINESS_OWNER_NAME=
# BUSINESS_TENANT_NAME=
# BUSINESS_OWNER_PASSWORD=

# Durable workflows. Existing databases require explicit installation/import first.
AUTOMATION_ENABLED=false
# Base64-encoded 32 random bytes; keep securely outside the database/repository.
# AUTOMATION_MASTER_KEY_B64=
BILLING_ENABLED=false
# Optional account website root aliases; all tenants get /tenants/<UUID>/... routes.
# ACCOUNT_TENANT_ID=<tenant UUID>

# Operator import sources ONLY. Managed runtimes use encrypted tenant connections.
# TENANT_FINANCIAL_SETTINGS_JSON=[{"tenant_id":"<tenant UUID>","sandbox":true,"default_financial":"stripe","webhook_secret":"whsec_...","reminder_days":7}]
# TENANT_NOTIFICATION_PLUGINS_JSON=[{"tenant_id":"<tenant UUID>","plugin":"resend","token":"re_...","from":"JITPOMI <billing@jitpomi.com>","allowed_test_recipients":["dev@jitpomi.com"]}]
# AUTOMATION_WRITERS_STOPPED=true
# AUTOMATION_BACKUP_DIR=<private verified backup directory>
# AUTOMATION_IMPORT_TENANT=<tenant UUID>
# AUTOMATION_IMPORT_OWNER=<active owner identity UUID>
