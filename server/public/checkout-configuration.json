  "currencies": [
    "USD",
    "EUR",
    "GBP",
    "CAD",
    "AUD",
    "JPY"
  ],
  "modes": [
    "once",
    "recurring",
    "instalments"
  ],
  "messages": {
    "invoice": {
      "subject": "Your invoice",
      "text": "Your invoice {invoice_id} for {description} is ready.\nAmount: {amount}\nDue: {due_at}\nView and pay securely: {url}",
      "enabled": true
    },
    "reminder": {
      "subject": "Payment reminder",
      "text": "Your invoice {invoice_id} for {description} is due.\nAmount: {amount}\nDue: {due_at}\nView and pay securely: {url}\nIf payment is already processing, no further action is needed.",
      "enabled": true
    },
    "receipt": {
      "subject": "Payment received",
      "text": "Thank you. Your invoice {invoice_id} for {description} is marked paid.\nAmount: {amount}\nView your invoice: {url}",
      "enabled": true
    },
    "refund": {
      "subject": "Refund confirmed",
      "text": "Your refund of {amount} for invoice {invoice_id} is confirmed by the payment provider.\nRequest: {refund_id}",
      "enabled": true
    }
  },
  "template_variables": [
    "invoice_id",
    "description",
    "amount",
    "due_at",
    "url",
    "refund_id",
    "merchant",
    "support"
  ],
  "kinds": [
    "product",
    "service",
    "donation"
  ]
