match $c isa bill_customer;
let $buyer=request_bill_buyer($c);let $seller=request_bill_seller($c);
fetch {"id":$c.bill_key,"buyer":$buyer,"seller":$seller,"name":$c.name,"email":$c.bill_email,"policy":$c.bill_policy,"choice":$c.bill_choice,"manual_provider":$c.bill_provider,"revision":$c.bill_revision};
